    },
    {
      "id": "abby-tts-template-ff686638467357e9daee",
      "maskedHash": "ff686638467357e9daee",
      "maskedText": "After you\u2019re safe, call two one one for shelter and warming center help.",
      "chunkIds": [
        "abby-tts-chunk-ff686638467357e9daee"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff69970bdb0e70458d46",
      "maskedHash": "ff69970bdb0e70458d46",
      "maskedText": "You\u2019re doing the right thing calling, and I\u2019m really glad you told me.",
