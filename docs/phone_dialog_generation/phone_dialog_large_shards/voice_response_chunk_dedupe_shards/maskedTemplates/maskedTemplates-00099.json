      "id": "abby-tts-template-ffab15de6b4518453e1a",
      "maskedHash": "ffab15de6b4518453e1a",
      "maskedText": "You can call 5-4-1 \u2026 2-2-1 \u2026 0-8-2-4.",
      "chunkIds": [
        "abby-tts-chunk-ffab15de6b4518453e1a"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ffab6e90145131f106aa",
      "maskedHash": "ffab6e90145131f106aa",
      "maskedText": "Your mom is seventy-nine, and you think she may be neglected.",
      "chunkIds": [
        "abby-tts-chunk-ffab6e90145131f106aa"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ffac5c58f8e2e4b55382",
      "maskedHash": "ffac5c58f8e2e4b55382",
      "maskedText": "Can I get food today without ID?\u201d If you want, I can stay with you while you make that call.",
