    },
    {
      "id": "abby-tts-template-ffad30650579843645e7",
      "maskedHash": "ffad30650579843645e7",
      "maskedText": "If no answer: {number_1} \u2026 {number_2} \u2026 {number_3}.",
      "chunkIds": [
        "abby-tts-chunk-d71e5f39738100862a46"
      ],
