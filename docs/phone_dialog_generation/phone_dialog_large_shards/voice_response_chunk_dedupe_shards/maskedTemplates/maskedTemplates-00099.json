      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff65671eb55af42608e4",
      "maskedHash": "ff65671eb55af42608e4",
      "maskedText": "If baby looks limp, blue, or has trouble breathing, call nine one one immediately.",
