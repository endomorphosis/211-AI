      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ffb41ed62328d1491f8a",
      "maskedHash": "ffb41ed62328d1491f8a",
      "maskedText": "You can say this, slowly: \u201cI believe you.",
