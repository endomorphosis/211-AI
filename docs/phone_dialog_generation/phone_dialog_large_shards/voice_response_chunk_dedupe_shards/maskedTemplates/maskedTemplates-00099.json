        "abby-tts-chunk-ff65671eb55af42608e4"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff657ab6414eeb25f232",
      "maskedHash": "ff657ab6414eeb25f232",
      "maskedText": "Third: 3 9 8 3.",
      "chunkIds": [
        "abby-tts-chunk-ff657ab6414eeb25f232"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff6645bb5a7ae7d6533b",
      "maskedHash": "ff6645bb5a7ae7d6533b",
      "maskedText": "Let\u2019s check right now.",
      "chunkIds": [
        "abby-tts-chunk-ff6645bb5a7ae7d6533b"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff67371e6ed6f0ebf1a8",
      "maskedHash": "ff67371e6ed6f0ebf1a8",
      "maskedText": "Then call {entity_1} and say, \u201cI have Court papers in hand.",
      "chunkIds": [
        "abby-tts-chunk-27d3c7d37d96f4366c55"
      ],
      "reuseCount": 1,
      "slotKinds": {
        "entity": 1
