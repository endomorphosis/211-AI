        "abby-tts-chunk-ff69970bdb0e70458d46"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff6af617d66bd0e1df4e",
      "maskedHash": "ff6af617d66bd0e1df4e",
      "maskedText": "Next step: stay on this line and I\u2019ll transfer you now to a live two one one specialist for the closest open cooling center.",
      "chunkIds": [
        "abby-tts-chunk-ff6af617d66bd0e1df4e"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff6b15016c3f7f94e2f1",
      "maskedHash": "ff6b15016c3f7f94e2f1",
      "maskedText": "Do you want the second phone number too?",
      "chunkIds": [
        "abby-tts-chunk-ff6b15016c3f7f94e2f1"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff6cd65d131c9d58a773",
      "maskedHash": "ff6cd65d131c9d58a773",
      "maskedText": "If pain becomes severe with swelling or fever, urgent care is a good backup.",
      "chunkIds": [
        "abby-tts-chunk-ff6cd65d131c9d58a773"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff6fbbabf52b8e273910",
      "maskedHash": "ff6fbbabf52b8e273910",
      "maskedText": "First step: call 8 5 5 \u2026 3 2 8 \u2026 6 7 1 5.",
      "chunkIds": [
        "abby-tts-chunk-ff6fbbabf52b8e273910"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff6fe4970ec4bcb8e40a",
      "maskedHash": "ff6fe4970ec4bcb8e40a",
      "maskedText": "If this phone dies, ask transit, library, or store staff to dial two one one with you.",
      "chunkIds": [
        "abby-tts-chunk-ff6fe4970ec4bcb8e40a"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff706c84834db3211d8f",
      "maskedHash": "ff706c84834db3211d8f",
      "maskedText": "and I can connect you to a live specialist now for a safety plan and a safe Place tonight in {location_1}.",
      "chunkIds": [
        "abby-tts-chunk-8a08b42e71542e5e1cc5"
      ],
      "reuseCount": 1,
      "slotKinds": {
        "location": 1
      },
      "topSlotValues": {
        "location": [
          [
            "Portland",
            1
          ]
        ]
      }
    },
    {
      "id": "abby-tts-template-ff74942d7d67c11b499d",
      "maskedHash": "ff74942d7d67c11b499d",
      "maskedText": "And 5 4 1 \u2026 9 6 7 \u2026 8 6 3 0.",
      "chunkIds": [
        "abby-tts-chunk-ff74942d7d67c11b499d"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff7b5e4f7a40d36eafa9",
      "maskedHash": "ff7b5e4f7a40d36eafa9",
      "maskedText": "I can connect you to a live person now to stay with you and help with next steps.",
