      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ffb3807af8bd477b1491",
      "maskedHash": "ffb3807af8bd477b1491",
      "maskedText": "I\u2019ll repeat it clearly: no documents required.",
