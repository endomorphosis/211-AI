      "id": "abby-tts-template-ffb73f3a19a332c5c1a8",
      "maskedHash": "ffb73f3a19a332c5c1a8",
      "maskedText": "You can stay anonymous and share only what you choose.",
      "chunkIds": [
        "abby-tts-chunk-ffb73f3a19a332c5c1a8"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
