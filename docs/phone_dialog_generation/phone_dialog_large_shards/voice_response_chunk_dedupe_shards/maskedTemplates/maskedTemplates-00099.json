        "abby-tts-chunk-ff899de7103473953327"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff8a0c0191f72e0a0906",
      "maskedHash": "ff8a0c0191f72e0a0906",
      "maskedText": "You can ask, \u201cWhat is the minimum info you need for a checkup?\u201d Do you want me to help you with that exact first sentence for the call?",
      "chunkIds": [
        "abby-tts-chunk-ff8a0c0191f72e0a0906"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff8e5c270cc65eba345c",
      "maskedHash": "ff8e5c270cc65eba345c",
      "maskedText": "Slow version: 5 4 1 \u2026 6 8 9 \u2026 3 1 1 1.",
      "chunkIds": [
        "abby-tts-chunk-ff8e5c270cc65eba345c"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff90185ca2fb0cc31e3e",
      "maskedHash": "ff90185ca2fb0cc31e3e",
      "maskedText": "I can\u2019t see your wallet unless you choose to share your screen.",
      "chunkIds": [
        "abby-tts-chunk-ff90185ca2fb0cc31e3e"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff93d469ae21f4aeb810",
      "maskedHash": "ff93d469ae21f4aeb810",
      "maskedText": "You can still go.",
      "chunkIds": [
        "abby-tts-chunk-ff93d469ae21f4aeb810"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff94991b152dbd05fc9e",
      "maskedHash": "ff94991b152dbd05fc9e",
      "maskedText": "Since you\u2019re not safe-feeling and haven\u2019t slept for two days, I\u2019m connecting you to a live mental health counselor right now.",
      "chunkIds": [
        "abby-tts-chunk-ff94991b152dbd05fc9e"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff975f92d7addbd7e186",
      "maskedHash": "ff975f92d7addbd7e186",
      "maskedText": "I do not have verified hours in front of me.",
      "chunkIds": [
        "abby-tts-chunk-ff975f92d7addbd7e186"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff9b5ff0744a1709dccb",
      "maskedHash": "ff9b5ff0744a1709dccb",
