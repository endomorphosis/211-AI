        "abby-tts-chunk-ff7b5e4f7a40d36eafa9"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff7c383624c57a3c173f",
      "maskedHash": "ff7c383624c57a3c173f",
      "maskedText": "Tell them: \u201cI\u2019m in {location_1}, I feel very sick, I might pass out, and this phone is at two percent battery.\u201d If you can, sit or lie down on your side, unlock the door, and stay on the line.",
      "chunkIds": [
        "abby-tts-chunk-5e76a8aa8ad0d792adc4"
      ],
      "reuseCount": 1,
      "slotKinds": {
        "location": 1
      },
      "topSlotValues": {
        "location": [
          [
            "Clackamas",
            1
          ]
        ]
      }
    },
    {
      "id": "abby-tts-template-ff7f4430934262f15353",
      "maskedHash": "ff7f4430934262f15353",
      "maskedText": "If you feel faint, confused, or close to passing out, call nine one one now.",
      "chunkIds": [
        "abby-tts-chunk-ff7f4430934262f15353"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff7f5b3a2d57839a6a9f",
      "maskedHash": "ff7f5b3a2d57839a6a9f",
      "maskedText": "The audio is unclear on my end too.",
      "chunkIds": [
        "abby-tts-chunk-ff7f5b3a2d57839a6a9f"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff8013a207e60172ed71",
      "maskedHash": "ff8013a207e60172ed71",
      "maskedText": "You\u2019re okay, I can repeat it.",
      "chunkIds": [
        "abby-tts-chunk-ff8013a207e60172ed71"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff801b36770ba4db6e67",
      "maskedHash": "ff801b36770ba4db6e67",
      "maskedText": "If you want, I can help you with a short script to use on each call so they triage you faster.",
      "chunkIds": [
        "abby-tts-chunk-ff801b36770ba4db6e67"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff8137f58a23f6219949",
      "maskedHash": "ff8137f58a23f6219949",
      "maskedText": "Most important step right now: if you might faint or can\u2019t stay steady, call nine one one now.",
      "chunkIds": [
        "abby-tts-chunk-ff8137f58a23f6219949"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ff899de7103473953327",
      "maskedHash": "ff899de7103473953327",
      "maskedText": "It is free, and they give customized referrals for affordable child care and preschool.",
