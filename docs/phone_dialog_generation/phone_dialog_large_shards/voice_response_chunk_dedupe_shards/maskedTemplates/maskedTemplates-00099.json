      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ffb5580c570ee546be08",
      "maskedHash": "ffb5580c570ee546be08",
      "maskedText": "Please say: \u201cI have asthma symptoms and my chest is getting tighter.",
