        "abby-tts-chunk-ffa69811d36ef463e59f"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ffaa0af687009e745508",
      "maskedHash": "ffaa0af687009e745508",
      "maskedText": "After nine one one, I will connect you to two one one for the nearest cooling center.",
