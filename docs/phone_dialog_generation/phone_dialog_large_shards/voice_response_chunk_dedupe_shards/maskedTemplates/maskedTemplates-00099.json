    {
      "id": "abby-tts-template-ffa376fb49b3786299d1",
      "maskedHash": "ffa376fb49b3786299d1",
      "maskedText": "If there is any immediate danger, call nine one one now.",
      "chunkIds": [
        "abby-tts-chunk-ffa376fb49b3786299d1"
      ],
      "reuseCount": 1,
      "slotKinds": {},
      "topSlotValues": {}
    },
    {
      "id": "abby-tts-template-ffa69811d36ef463e59f",
      "maskedHash": "ffa69811d36ef463e59f",
      "maskedText": "I\u2019m keeping your info as limited as possible and getting a live two one one specialist on the line for safe shelter options tonight.",
