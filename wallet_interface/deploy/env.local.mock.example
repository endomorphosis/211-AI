# Local development overrides for running the bridge-backed stack without
# provider credentials or a remote phone-voice backend.

WALLET_STORAGE_CONFIG={"primary":{"type":"local","root":"/var/lib/211-ai/wallet-blobs"}}
IPFS_DATASETS_PY_ENABLE_IPFS_HTTPAPI=1
IPFS_HOST=/dns/ipfs/tcp/5001/http
WALLET_IPFS_UPLOAD_BACKEND=
WALLET_IPFS_PUBLIC_GATEWAY_BASE_URL=/ipfs-proxy
ABBY_RUNTIME_WALRUS_PUBLISHER_URL=https://publisher.walrus-testnet.walrus.space
ABBY_RUNTIME_WALRUS_AGGREGATOR_URL=https://aggregator.walrus-testnet.walrus.space
ABBY_RUNTIME_WALRUS_DELETE_URL=
ABBY_RUNTIME_WALRUS_CLIENT_TOKEN=
ABBY_RUNTIME_WALRUS_EPOCHS=5
ABBY_RUNTIME_WALRUS_DELETABLE=false
WALLET_SMS_INBOUND_BEARER_TOKEN=local-dev-inbound-secret
WALLET_FILECOIN_PIN_SERVICE_URL=http://filecoin-pin:3456
WALLET_FILECOIN_PIN_MOCK_STATUS=pinned
WALLET_FILECOIN_PIN_ORIGINS=/dns/ipfs/tcp/4001
IPFS_DATASETS_SMS_BRIDGE_ARCHIVE_EXPORT_ENABLED=true
IPFS_DATASETS_SMS_BRIDGE_ARCHIVE_EXPORT_INTERVAL_SECONDS=3600
IPFS_DATASETS_SMS_BRIDGE_ARCHIVE_EXPORT_ROOT=/var/lib/211-ai/sms-bridge/exports
FILECOIN_PIN_NETWORK=calibration
FILECOIN_PIN_PRIVATE_KEY=0x1111111111111111111111111111111111111111111111111111111111111111
WALLET_PROOF_MODE=production
WALLET_PROOF_BACKEND=deterministic-location-region

# Local deterministic Chainlink/ZKML consensus settings. These exercise the
# wallet/UI contract without requiring live Chainlink CRE or libp2p peers.
IPFS_ACCELERATE_PY_LLM_CONSENSUS_ENABLED=true
IPFS_ACCELERATE_PY_LLM_CONSENSUS_MODE=local_quorum
IPFS_ACCELERATE_PY_LLM_CONSENSUS_COMPARISON=canonical_json
IPFS_ACCELERATE_PY_LLM_CONSENSUS_QUORUM=1
IPFS_ACCELERATE_PY_LLM_CONSENSUS_MIN_OPERATORS=1
IPFS_ACCELERATE_PY_LLM_CONSENSUS_OPERATOR_COUNT=1
IPFS_ACCELERATE_PY_LLM_CONSENSUS_PEERS=local-mock-router
IPFS_ACCELERATE_PY_LLM_CONSENSUS_OPERATOR_ID=wallet-router-local
IPFS_ACCELERATE_PY_LLM_CONSENSUS_TIMEOUT_S=10
IPFS_ACCELERATE_PY_LLM_CONSENSUS_OPERATOR_TIMEOUT_S=5
IPFS_ACCELERATE_PY_LLM_CONSENSUS_FAIL_CLOSED=false
IPFS_ACCELERATE_PY_LLM_CONSENSUS_PROMPT_REDACTION_POLICY=hash_only
IPFS_ACCELERATE_PY_LLM_CONSENSUS_MODEL_COMMITMENT=mock-model-policy@local
IPFS_ACCELERATE_PY_LLM_CONSENSUS_TOKENIZER_COMMITMENT=mock-tokenizer@local
IPFS_ACCELERATE_PY_LLM_CONSENSUS_RECEIPT_PATH=/tmp/211-ai-llm-consensus/latest-receipt.json
IPFS_ACCELERATE_PY_LLM_CONSENSUS_RECEIPT_JSONL_PATH=/tmp/211-ai-llm-consensus/receipts.jsonl
IPFS_ACCELERATE_PY_LLM_PROOF_VERIFIER=mock-chainlink-cre-verifier
IPFS_ACCELERATE_PY_CHAINLINK_CRE_WORKFLOW_ID=mock-cre-workflow-local
IPFS_ACCELERATE_PY_CHAINLINK_CRE_DON_ID=mock-don-local
IPFS_ACCELERATE_PY_CHAINLINK_CRE_REGISTRY=private
IPFS_ACCELERATE_PY_CHAINLINK_CRE_CHAIN_ID=
IPFS_ACCELERATE_PY_CHAINLINK_CRE_ENDPOINT=http://127.0.0.1:8787/mock-cre
IPFS_ACCELERATE_PY_CHAINLINK_VERIFIER_CONTRACT=
IPFS_ACCELERATE_PY_RUN_CHAINLINK_CRE_TESTS=0
IPFS_ACCELERATE_PY_RUN_LLM_CONSENSUS_P2P_TESTS=0

IPFS_DATASETS_EMAIL_PROVIDER_KIND=mock
IPFS_DATASETS_SMS_PROVIDER_KIND=mock
IPFS_DATASETS_SMS_TWILIO_FROM_PHONE=+15035550100
IPFS_DATASETS_CALL_PROVIDER_KIND=mock
IPFS_DATASETS_CALL_TWILIO_FROM_PHONE=+15035550100
IPFS_DATASETS_VOICE_REPLY_PROVIDER_KIND=mock
IPFS_DATASETS_VOICE_MOCK_REPLY_TEXT=This is a local mock reply from Abby. Configure a real voice backend when credentials are ready.

# The browser voice UI can use the bridge's same-origin mock proxy routes.
# Those routes return deterministic text and the UI speaks it with browser
# speech output, so you can exercise the full voice flow without provider keys.
ABBY_RUNTIME_VOICE_PROXY_ENABLED=true
ABBY_RUNTIME_VOICE_PROXY_MODEL=mock-voice-proxy
ABBY_RUNTIME_VOICE_PROXY_BASE_URL=
ABBY_RUNTIME_VOICE_PROXY_INFER_URL=/messaging/voice/infer
ABBY_RUNTIME_VOICE_PROXY_TTS_URL=/messaging/voice/tts
ABBY_RUNTIME_VOICE_PROXY_STT_URL=
